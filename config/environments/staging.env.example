# This is a TEMPLATE committed to git -- no real credentials. Copy
# this file to the same name without '.example' (e.g. qa.env) for
# local overrides of non-secret values only; the real file stays
# git-ignored (config/environments/*.env). Login email/password and
# the SMS API token are NEVER put in this file -- see the SECRETS
# note below and README's "Secrets" section.

# config/environments/staging.env — loaded when ENV=staging.
# This is the environment the suite has actually been run against so far
# (BASE_URL below matches what utils/config.py's built-in default has always
# pointed at). See config/environments/qa.env for field comments.
#
# ENV_NAME=staging matches ENV=staging here -- already the verified
# pairing (see scripts/validate_config.py's _VERIFIED_ENV_NAME_PAIRINGS),
# unlike qa.env's ENV=qa / ENV_NAME=dev. Nothing to correct.
#
# SECRETS: login email/password and the SMS API token are NOT stored in
# this file (or committed anywhere) -- they come from environment
# variables: STAGING_EMAIL, STAGING_PASSWORD, SMS_API_TOKEN_STAGING. Set
# them in your shell / root .env for local runs; Bitbucket supplies them
# as secured repository variables in CI. See README's "Secrets" section.

ENV=staging
ENV_NAME=staging
BASE_URL=https://testqa.cpaas.globeteleservices.com
API_URL=https://testqa.cpaas.globeteleservices.com/api
TENANT=default

HEADLESS=false
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20
# CI default — override per-job with the PLAYWRIGHT_WORKERS env var. Do not
# assume the CI runner has the same CPU/RAM as a developer laptop.
PLAYWRIGHT_WORKERS=10

SMS_SENDER_ID=DUMMY
SMS_TEMPLATE_NAME=AutoTmpl_98AK56
SMS_TEMPLATE_WITH_VARS=AutoTmpl_98AK56
SMS_PASTE_CONTACTS=919876543210\n919988887777\n919999999999\n919888888888
SMS_CAMPAIGN_PREFIX=AutoCamp
SMS_OTP_TEMPLATE_NAME=OTP_Test

# TRANSACTIONAL template for the transaction-template DLR test
# (tests/sms/campaigns/test_sms_campaign_transaction_template_dlr.py)
SMS_TRANSACTION_TEMPLATE=Template9_7WT8C8
SMS_TRANSACTION_TEMPLATE_TYPE=TRANSACTIONAL

# Template for the DLR + short-URL click-count test
# (tests/sms/campaigns/test_sms_campaign_short_url_click_dlr.py)
SMS_URL_CLICK_TEMPLATE=test_url_template
SMS_URL_CLICK_TEMPLATE_TYPE=TRANSACTIONAL

# ── Email Campaign test data ───────────────────────────────────────────────────
# Change these to match what exists on the target instance

# Email Service option value or name that exists on this instance
EMAIL_SERVICE=Staging AmazonSES

# Email Template name/ID used for campaign tests
EMAIL_TEMPLATE_NAME=test template

# Template that HAS dynamic variables
EMAIL_TEMPLATE_WITH_VARS=test template

# Email addresses for copy-paste import (one per line, use \n between)
EMAIL_PASTE_CONTACTS=navjot.singh@globeteleservices.com\npushpender.rajput@globeteleservices.com\aman.tiwari@globeteleservices.com\ndharam.singh@globeteleservices.com

# Prefix for auto-generated campaign names
EMAIL_CAMPAIGN_PREFIX=AutoEmailCamp

# Default Email Subject Line
EMAIL_SUBJECT=QA Automated Subject Line


# ── RCS Campaign test data ────────────────────────────────────────────────────
# The visible name of the RCS Agent to select when creating a campaign
RCS_AGENT_NAME=agentsim

# Phone number(s) pasted into RCS Campaign's "Copy Paste Numbers" import tab
# (comma-separated if more than one)
RCS_PASTE_CONTACTS=919202511257\n919876543210\n919988887777\n919999999999\n919888888888

