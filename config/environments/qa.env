# config/environments/qa.env
# Loaded automatically when ENV=qa (the default — see utils/config.py).
# Copy this pattern for a new environment file; never commit real secrets —
# in CI, set these as CI/CD secret variables instead of a committed .env file
# (see docs/ARCHITECTURE.md "CI/CD" section).

ENV=qa
BASE_URL=https://testqa.gtsstaging.com
API_URL=https://testqa.gtsstaging.com/api
TENANT=default

VALID_EMAIL=
VALID_PASSWORD=

HEADLESS=false
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20

# Default parallel worker count for this environment when PLAYWRIGHT_WORKERS
# isn't set explicitly on the command line / CI variable. See
# docs/ARCHITECTURE.md "Parallel execution" — start conservative, raise only
# after confirming the target app/API tolerates it (rule: do not blindly
# maximize workers).
PLAYWRIGHT_WORKERS=4

# ── SMS Campaign test data ──────────────────────────────────────────────
SMS_SENDER_ID=DUMMY
SMS_TEMPLATE_NAME=click test - click_test
SMS_TEMPLATE_WITH_VARS=newtempdemo
SMS_PASTE_CONTACTS=919876543210\n919988887777\n919999999999\n919888888888
SMS_CAMPAIGN_PREFIX=AutoCamp

# ── Email Campaign test data ────────────────────────────────────────────
EMAIL_SERVICE=4
EMAIL_TEMPLATE_NAME=b85d84de-f6b5-4f21-a8e6-70e230a5c9e4
EMAIL_TEMPLATE_WITH_VARS=b85d84de-f6b5-4f21-a8e6-70e230a5c9e4
EMAIL_PASTE_CONTACTS=qa1@example.com\nqa2@example.com\nqa3@example.com\nqa4@example.com
EMAIL_CAMPAIGN_PREFIX=AutoEmailCamp
EMAIL_SUBJECT=QA Automated Subject Line

# ── Contacts / Segmentation test data ───────────────────────────────────
CONTACT_TAGS=demo,test,campaign
SEGMENT_FIELDS=address,education

# ── RCS test data ────────────────────────────────────────────────────────
RCS_AGENT_NAME=agentsim
