# ── CPaaS+ Selenium Test Configuration ───────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in values for your instance
# 3. Never commit .env to git — it contains credentials
#
# To switch instances: change the values below. No test files need editing.
# ─────────────────────────────────────────────────────────────────────────────

# Application URL (no trailing slash)
BASE_URL=https://your-instance.example.com

# Login credentials for the test account
VALID_EMAIL=your_email@example.com
VALID_PASSWORD=your_password_here

# Browser: chrome | firefox
BROWSER=chrome

# Headless mode (no visible window): true | false
HEADLESS=false

# Timeouts in seconds
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20

# ── SMS Campaign test data ────────────────────────────────────────────────────
# These must match data that actually exists on your instance.

# An approved Sender ID (check Sender IDs tab)
SMS_SENDER_ID=DUMMY

# A template with NO dynamic variables (for basic campaign tests)
SMS_TEMPLATE_NAME=click test - click_test

# A template WITH dynamic variables (for TC_C023 / TC_C024)
SMS_TEMPLATE_WITH_VARS=newtempdemo

# Phone numbers for copy-paste import (one per line, use \n between)
SMS_PASTE_CONTACTS=919876543210\n919988887777\n919999999999\n919888888888

# Short prefix for auto-generated campaign names
SMS_CAMPAIGN_PREFIX=AutoCamp

# ── Email Campaign test data ───────────────────────────────────────────────────
# These must match data that actually exists on your instance.

# Email Service ID or name (check Email Services dropdown)
EMAIL_SERVICE=4

# An email template ID or name (for basic campaign tests)
EMAIL_TEMPLATE_NAME=b85d84de-f6b5-4f21-a8e6-70e230a5c9e4

# An email template WITH dynamic variables
EMAIL_TEMPLATE_WITH_VARS=b85d84de-f6b5-4f21-a8e6-70e230a5c9e4

# Email addresses for copy-paste import (one per line, use \n between)
EMAIL_PASTE_CONTACTS=qa1@example.com\nqa2@example.com\nqa3@example.com\nqa4@example.com

# Short prefix for auto-generated campaign names
EMAIL_CAMPAIGN_PREFIX=AutoEmailCamp

# Default Email Subject Line
EMAIL_SUBJECT=QA Automated Subject Line

# ── Contacts / Segmentation test data ────────────────────────────────────────
# These must match data that actually exists on your instance.

# Valid contact tag names (comma-separated, no spaces needed)
CONTACT_TAGS=demo,test,campaign

# Valid segmentation custom-field names (comma-separated)
SEGMENT_FIELDS=address,education
