# ── SMS Campaign test data ────────────────────────────────────────────────────
# Change these to match what exists on the target instance

# A Sender ID that exists and is approved on this instance
SMS_SENDER_ID=DUMMY
; SMS_SENDER_ID=123456
# A template with no dynamic variables (used in basic campaign tests)
; SMS_TEMPLATE_NAME=click test - click_test
SMS_TEMPLATE_NAME=AutoTmpl_98AK56
# A template that HAS dynamic variables (used in TC_C023 / TC_C024)
SMS_TEMPLATE_WITH_VARS=AutoTmpl_98AK56

# Phone numbers for copy-paste import (one per line, use \n between)
SMS_PASTE_CONTACTS=919876543210\n919988887777\n919999999999\n919888888888

# Prefix for auto-generated campaign names
SMS_CAMPAIGN_PREFIX=AutoCamp


# ── Email Campaign test data ───────────────────────────────────────────────────
# Change these to match what exists on the target instance

# Email Service option value or name that exists on this instance
EMAIL_SERVICE=Staging AmazonSES

# Email Template name/ID used for campaign tests
EMAIL_TEMPLATE_NAME=test template

# Template that HAS dynamic variables
EMAIL_TEMPLATE_WITH_VARS=test template

# Email addresses for copy-paste import (one per line, use \n between)
